	echo Build command was: "/home/dsh/Ascend/cann-9.0.0/compiler/tikcpp/ascendc_kernel_cmake/fwk_modules/util/makeself/makeself.sh \\
    \"--header\" \\
    \"/home/dsh/Ascend/cann-9.0.0/compiler/tikcpp/ascendc_kernel_cmake/fwk_modules/util/makeself/makeself-header.sh\" \\
    \"--help-header\" \\
    \"./help.info\" \\
    \"--tar-format\" \\
    \"posix\" \\
    \"--gzip\" \\
    \"--complevel\" \\
    \"4\" \\
    \"--nomd5\" \\
    \"--sha256\" \\
    \"./\" \\
