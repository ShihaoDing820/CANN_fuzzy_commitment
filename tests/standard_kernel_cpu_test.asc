#include <algorithm>
#include <array>
#include <cstdint>
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif
#include "kernel_operator.h"

#include "fuzzy_commitment_ada_m_trans_custom_tiling.h"
#include "fuzzy_commitment_ldpc_recover_custom_tiling.h"

// CPU Debug launch metadata is generated per translation unit. Including the
// two production kernel sources here lets the test launch the exact same code
// that is compiled into the custom OPP package.
#include "../custom_opp/op_kernel/fuzzy_commitment_ada_m_trans_custom.cpp"
#include "../custom_opp/op_kernel/fuzzy_commitment_ldpc_recover_custom.cpp"

namespace {

constexpr int32_t kBaseRows = 42;
constexpr int32_t kBaseColumns = 52;
constexpr int32_t kLiftSize = 10;

struct LdpcGraph {
    std::array<int32_t, kCheckCount + 1> checkOffsets{};
    std::array<int32_t, kEdgeCount> checkVariables{};
    std::array<int32_t, kVariableCount + 1> variableOffsets{};
    std::array<int32_t, kEdgeCount> variableEdges{};
};

void CheckAcl(aclError code, const std::string& operation)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(operation + " returned ACL error " + std::to_string(code));
    }
}

template <typename T>
T* AllocateDevice(std::size_t count, const std::string& name)
{
    T* pointer = nullptr;
    CheckAcl(
        aclrtMalloc(
            reinterpret_cast<void**>(&pointer),
            count * sizeof(T),
            ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc(" + name + ")");
    return pointer;
}

template <typename T>
void CopyHostToDevice(T* device, const T* host, std::size_t count, const std::string& name)
{
    const std::size_t bytes = count * sizeof(T);
    CheckAcl(
        aclrtMemcpy(device, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE),
        "copy H2D " + name);
}

template <typename T>
void CopyDeviceToHost(T* host, const T* device, std::size_t count, const std::string& name)
{
    const std::size_t bytes = count * sizeof(T);
    CheckAcl(
        aclrtMemcpy(host, bytes, device, bytes, ACL_MEMCPY_DEVICE_TO_HOST),
        "copy D2H " + name);
}

LdpcGraph BuildLdpcGraph()
{
    std::ifstream input(WIFAKEY_BG2_PATH);
    if (!input) {
        throw std::runtime_error("cannot open WiFaKey BG2 matrix");
    }
    std::array<std::array<int32_t, kBaseColumns>, kBaseRows> baseGraph{};
    for (auto& row : baseGraph) {
        for (int32_t& value : row) {
            if (!(input >> value)) {
                throw std::runtime_error("invalid WiFaKey BG2 matrix");
            }
        }
    }

    LdpcGraph graph;
    std::array<std::vector<int32_t>, kVariableCount> variableEdgeLists;
    int32_t edge = 0;
    for (int32_t baseRow = 0; baseRow < kBaseRows; ++baseRow) {
        for (int32_t liftRow = 0; liftRow < kLiftSize; ++liftRow) {
            const int32_t check = baseRow * kLiftSize + liftRow;
            graph.checkOffsets[check] = edge;
            for (int32_t baseColumn = 0; baseColumn < kBaseColumns; ++baseColumn) {
                const int32_t shift = baseGraph[baseRow][baseColumn];
                if (shift < 0) {
                    continue;
                }
                if (edge >= kEdgeCount) {
                    throw std::runtime_error("LDPC graph has too many edges");
                }
                const int32_t variable =
                    baseColumn * kLiftSize + (liftRow + shift) % kLiftSize;
                graph.checkVariables[edge] = variable;
                variableEdgeLists[variable].push_back(edge);
                ++edge;
            }
        }
    }
    graph.checkOffsets[kCheckCount] = edge;
    if (edge != kEdgeCount) {
        throw std::runtime_error("LDPC graph edge count is not 1970");
    }

    int32_t variableEdgeIndex = 0;
    for (int32_t variable = 0; variable < kVariableCount; ++variable) {
        graph.variableOffsets[variable] = variableEdgeIndex;
        for (int32_t value : variableEdgeLists[variable]) {
            graph.variableEdges[variableEdgeIndex++] = value;
        }
    }
    graph.variableOffsets[kVariableCount] = variableEdgeIndex;
    return graph;
}

void TestAdaMTrans(aclrtStream stream)
{
    constexpr uint32_t kBatch = 5;
    constexpr uint32_t kCoreCount = 3;
    std::vector<float> embeddings(kBatch * kEmbeddingDimension);
    for (uint32_t row = 0; row < kBatch; ++row) {
        for (int32_t feature = 0; feature < kEmbeddingDimension; ++feature) {
            embeddings[row * kEmbeddingDimension + feature] =
                static_cast<float>((feature + static_cast<int32_t>(row)) % 9 - 4) * 0.25F;
        }
    }
    const std::array<float, 3> thresholds{-0.5F, 0.0F, 0.5F};
    std::array<uint16_t, kTemplateBits> mask{};
    for (int32_t bit = 0; bit < kTemplateBits; ++bit) {
        mask[bit] = bit % 5 == 0 ? 0U : 1U;
    }

    std::vector<uint16_t> expected(kBatch * kTemplateBits);
    for (uint32_t row = 0; row < kBatch; ++row) {
        for (int32_t feature = 0; feature < kEmbeddingDimension; ++feature) {
            const float value = embeddings[row * kEmbeddingDimension + feature];
            uint32_t level = 0;
            level += value >= thresholds[0] ? 1U : 0U;
            level += value >= thresholds[1] ? 1U : 0U;
            level += value >= thresholds[2] ? 1U : 0U;
            const int32_t base = feature * 3;
            expected[row * kTemplateBits + base] =
                static_cast<uint16_t>(level >= 3U) & mask[base];
            expected[row * kTemplateBits + base + 1] =
                static_cast<uint16_t>(level >= 2U) & mask[base + 1];
            expected[row * kTemplateBits + base + 2] =
                static_cast<uint16_t>(level >= 1U) & mask[base + 2];
        }
    }

    FuzzyCommitmentAdaMTransCustomTilingData tiling{
        kBatch,
        kBatch / kCoreCount,
        kBatch % kCoreCount,
        kCoreCount,
        1U,
        kEmbeddingDimension,
        3U,
    };

    float* embeddingsDevice = AllocateDevice<float>(embeddings.size(), "embeddings");
    float* thresholdsDevice = AllocateDevice<float>(thresholds.size(), "thresholds");
    uint16_t* maskDevice = AllocateDevice<uint16_t>(mask.size(), "mask");
    uint16_t* outputDevice = AllocateDevice<uint16_t>(expected.size(), "binaryTemplates");
    auto* tilingDevice = AllocateDevice<FuzzyCommitmentAdaMTransCustomTilingData>(1, "adaTiling");
    CopyHostToDevice(embeddingsDevice, embeddings.data(), embeddings.size(), "embeddings");
    CopyHostToDevice(thresholdsDevice, thresholds.data(), thresholds.size(), "thresholds");
    CopyHostToDevice(maskDevice, mask.data(), mask.size(), "mask");
    CopyHostToDevice(tilingDevice, &tiling, 1, "adaTiling");

    fuzzy_commitment_ada_m_trans_custom<<<kCoreCount, nullptr, stream>>>(
        reinterpret_cast<uint8_t*>(embeddingsDevice),
        reinterpret_cast<uint8_t*>(thresholdsDevice),
        reinterpret_cast<uint8_t*>(maskDevice),
        reinterpret_cast<uint8_t*>(outputDevice),
        nullptr,
        reinterpret_cast<uint8_t*>(tilingDevice));
    CheckAcl(aclrtSynchronizeStream(stream), "synchronize AdaMTrans standard kernel");

    std::vector<uint16_t> actual(expected.size());
    CopyDeviceToHost(actual.data(), outputDevice, actual.size(), "binaryTemplates");
    if (actual != expected) {
        throw std::runtime_error("standard AdaMTrans kernel differs from Host reference");
    }

    CheckAcl(aclrtFree(embeddingsDevice), "free embeddings");
    CheckAcl(aclrtFree(thresholdsDevice), "free thresholds");
    CheckAcl(aclrtFree(maskDevice), "free mask");
    CheckAcl(aclrtFree(outputDevice), "free binaryTemplates");
    CheckAcl(aclrtFree(tilingDevice), "free adaTiling");
    std::cout << "[PASS] standard AdaMTrans kernel: 5 rows on 3 cores, tail covered"
              << std::endl;
}

void TestLdpc(aclrtStream stream)
{
    constexpr uint32_t kBlockCount = 5;
    constexpr uint32_t kCoreCount = 3;
    const LdpcGraph graph = BuildLdpcGraph();
    std::vector<uint16_t> probe(kBlockCount * kVariableCount, 0U);
    std::vector<uint16_t> helper(kBlockCount * kVariableCount, 0U);
    // Equal non-zero positions exercise probe XOR helper while keeping the
    // received word equal to the valid all-zero codeword.
    for (uint32_t block = 0; block < kBlockCount; ++block) {
        const uint32_t position = block * kVariableCount + block * 17U;
        probe[position] = 1U;
        helper[position] = 1U;
    }

    FuzzyCommitmentLdpcRecoverCustomTilingData tiling{
        kBlockCount,
        kBlockCount / kCoreCount,
        kBlockCount % kCoreCount,
        kCoreCount,
        50U,
        4.0F,
        0.75F,
    };

    uint16_t* probeDevice = AllocateDevice<uint16_t>(probe.size(), "probe");
    uint16_t* helperDevice = AllocateDevice<uint16_t>(helper.size(), "helper");
    int32_t* checkOffsetsDevice =
        AllocateDevice<int32_t>(graph.checkOffsets.size(), "checkOffsets");
    int32_t* checkVariablesDevice =
        AllocateDevice<int32_t>(graph.checkVariables.size(), "checkVariables");
    int32_t* variableOffsetsDevice =
        AllocateDevice<int32_t>(graph.variableOffsets.size(), "variableOffsets");
    int32_t* variableEdgesDevice =
        AllocateDevice<int32_t>(graph.variableEdges.size(), "variableEdges");
    uint16_t* decodedDevice =
        AllocateDevice<uint16_t>(probe.size(), "decoded");
    int32_t* decodeOkDevice = AllocateDevice<int32_t>(kBlockCount, "decodeOk");
    int32_t* syndromeDevice = AllocateDevice<int32_t>(kBlockCount, "syndromeWeight");
    int32_t* iterationsDevice = AllocateDevice<int32_t>(kBlockCount, "iterations");
    auto* tilingDevice = AllocateDevice<FuzzyCommitmentLdpcRecoverCustomTilingData>(1, "ldpcTiling");

    CopyHostToDevice(probeDevice, probe.data(), probe.size(), "probe");
    CopyHostToDevice(helperDevice, helper.data(), helper.size(), "helper");
    CopyHostToDevice(
        checkOffsetsDevice, graph.checkOffsets.data(), graph.checkOffsets.size(), "checkOffsets");
    CopyHostToDevice(
        checkVariablesDevice,
        graph.checkVariables.data(),
        graph.checkVariables.size(),
        "checkVariables");
    CopyHostToDevice(
        variableOffsetsDevice,
        graph.variableOffsets.data(),
        graph.variableOffsets.size(),
        "variableOffsets");
    CopyHostToDevice(
        variableEdgesDevice,
        graph.variableEdges.data(),
        graph.variableEdges.size(),
        "variableEdges");
    CopyHostToDevice(tilingDevice, &tiling, 1, "ldpcTiling");

    fuzzy_commitment_ldpc_recover_custom<<<kCoreCount, nullptr, stream>>>(
        reinterpret_cast<uint8_t*>(probeDevice),
        reinterpret_cast<uint8_t*>(helperDevice),
        reinterpret_cast<uint8_t*>(checkOffsetsDevice),
        reinterpret_cast<uint8_t*>(checkVariablesDevice),
        reinterpret_cast<uint8_t*>(variableOffsetsDevice),
        reinterpret_cast<uint8_t*>(variableEdgesDevice),
        reinterpret_cast<uint8_t*>(decodedDevice),
        reinterpret_cast<uint8_t*>(decodeOkDevice),
        reinterpret_cast<uint8_t*>(syndromeDevice),
        reinterpret_cast<uint8_t*>(iterationsDevice),
        nullptr,
        reinterpret_cast<uint8_t*>(tilingDevice));
    CheckAcl(aclrtSynchronizeStream(stream), "synchronize LDPC standard kernel");

    std::vector<uint16_t> decoded(probe.size());
    std::array<int32_t, kBlockCount> decodeOk{};
    std::array<int32_t, kBlockCount> syndrome{};
    std::array<int32_t, kBlockCount> iterations{};
    CopyDeviceToHost(decoded.data(), decodedDevice, decoded.size(), "decoded");
    CopyDeviceToHost(decodeOk.data(), decodeOkDevice, decodeOk.size(), "decodeOk");
    CopyDeviceToHost(syndrome.data(), syndromeDevice, syndrome.size(), "syndromeWeight");
    CopyDeviceToHost(iterations.data(), iterationsDevice, iterations.size(), "iterations");
    if (std::any_of(decoded.begin(), decoded.end(), [](uint16_t value) { return value != 0U; })) {
        throw std::runtime_error("standard LDPC kernel did not recover the all-zero codeword");
    }
    for (uint32_t block = 0; block < kBlockCount; ++block) {
        if (decodeOk[block] != 1 || syndrome[block] != 0 || iterations[block] != 1) {
            throw std::runtime_error("standard LDPC metadata is incorrect");
        }
    }

    CheckAcl(aclrtFree(probeDevice), "free probe");
    CheckAcl(aclrtFree(helperDevice), "free helper");
    CheckAcl(aclrtFree(checkOffsetsDevice), "free checkOffsets");
    CheckAcl(aclrtFree(checkVariablesDevice), "free checkVariables");
    CheckAcl(aclrtFree(variableOffsetsDevice), "free variableOffsets");
    CheckAcl(aclrtFree(variableEdgesDevice), "free variableEdges");
    CheckAcl(aclrtFree(decodedDevice), "free decoded");
    CheckAcl(aclrtFree(decodeOkDevice), "free decodeOk");
    CheckAcl(aclrtFree(syndromeDevice), "free syndromeWeight");
    CheckAcl(aclrtFree(iterationsDevice), "free iterations");
    CheckAcl(aclrtFree(tilingDevice), "free ldpcTiling");
    std::cout << "[PASS] standard LDPC kernel: 5 blocks on 3 cores, tail covered"
              << std::endl;
}

}  // namespace

int main()
{
    try {
        CheckAcl(aclInit(nullptr), "aclInit");
        CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");
        aclrtStream stream = nullptr;
        CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

        TestAdaMTrans(stream);
        TestLdpc(stream);

        CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
        CheckAcl(aclrtResetDevice(0), "aclrtResetDevice");
        CheckAcl(aclFinalize(), "aclFinalize");
        std::cout << "[PASS] standard custom-op kernel CPU test completed" << std::endl;
        return EXIT_SUCCESS;
    } catch (const std::exception& error) {
        std::cerr << "[FAIL] " << error.what() << std::endl;
        return EXIT_FAILURE;
    }
}
